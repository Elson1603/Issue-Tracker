# ==========================================
# IGA Email Issue Tracker - Environment Config
# ==========================================

# Database Configuration (Neon PostgreSQL pooled connection recommended for production)
# Example Neon URL: postgresql+asyncpg://neondb_owner:<PASSWORD>@<ENDPOINT>-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/iga_tracker

# AI Extraction via Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/qwen2p5-72b-instruct
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# Report Storage & Templates
REPORT_STORAGE_DIR=storage/reports
TEMPLATE_EXCEL_PATH=templates/template.xlsx

# Security & Authentication
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Email Provider Configuration (Gmail OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=iga_support@licindia.com

# Email Provider Configuration (Microsoft 365 / Microsoft Graph)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REDIRECT_URI=http://localhost:5173/settings
MS365_REFRESH_TOKEN=
MS365_USER_EMAIL=iga_support@licindia.com
